&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,    /* Pro Micro Pin 1 (SCK) */
                    <NRF_PSEL(SPIM_MOSI, 0, 20)>,   /* Pro Micro Pin 0 (MOSI) */
                    <NRF_PSEL(SPIM_MISO, 1, 2)>;    /* Pro Micro Pin 2 (MISO - not used but needed by driver) */
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 20)>,
                    <NRF_PSEL(SPIM_MISO, 1, 2)>;
            low-power-enable;
        };
    };
};

&pro_micro_spi {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
}; 